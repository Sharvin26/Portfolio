---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import FAQAccordion from "../components/FAQAccordion.astro";
import JsonLd from "../components/schema/JsonLd.astro";
import { articleSchema, breadcrumbSchema, faqSchema } from "../lib/schema";

interface Props {
  guide: CollectionEntry<"guides">;
  headings: { depth: number; slug: string; text: string }[];
}

const { guide, headings } = Astro.props;
const { title, description, tldr, publishDate, updatedDate, category, relatedSlugs, faqs } = guide.data;
const slug = guide.id;
const canonical = `https://sharvinshah.com/guides/${slug}`;
const toc = headings.filter((h) => h.depth === 2);

const allGuides = await getCollection("guides");
const related = allGuides.filter((g) => relatedSlugs.includes(g.id));

const jsonLdItems: object[] = [
  articleSchema({ title, description, slug, publishDate, updatedDate }),
  breadcrumbSchema([
    { name: "Home", url: "https://sharvinshah.com" },
    { name: "Guides", url: "https://sharvinshah.com/guides" },
    { name: title, url: canonical },
  ]),
];
if (faqs.length > 0) jsonLdItems.push(faqSchema(faqs));
---

<BaseLayout title={`${title} | Sharvin Shah`} description={description} canonical={canonical}>
  <JsonLd data={jsonLdItems} />
  <div class="flex min-h-screen flex-col bg-background">
    <Navbar />
    <main class="py-14 md:py-20">
      <div class="max-w-[720px] mx-auto px-6">
        <nav aria-label="Breadcrumb" class="font-mono text-xs text-muted-foreground mb-8 flex items-center gap-2">
          <a href="/" class="tap-target hover:text-foreground">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/guides" class="tap-target hover:text-foreground">Guides</a>
          <span aria-hidden="true">/</span>
          <span class="text-foreground truncate" title={title}>{title}</span>
        </nav>

        <div class="section-label mb-4">{category}</div>
        <h1 class="font-display text-3xl md:text-4xl lg:text-5xl font-semibold leading-tight mb-4">
          {title}
        </h1>
        <p class="font-mono text-xs text-muted-foreground mb-10">
          Published {publishDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
          {updatedDate && (
            <>
              {" "}· Updated {updatedDate.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
            </>
          )}
        </p>

        <aside class="border-l-2 pl-5 py-1 mb-10" style="border-color: var(--accent-500)">
          <p class="font-mono text-xs font-semibold uppercase tracking-widest text-primary mb-2">TL;DR</p>
          <p class="text-base leading-relaxed max-w-[33rem]">{tldr}</p>
        </aside>

        <slot name="diagram" />

        {toc.length > 0 && (
          <nav aria-label="Table of contents" class="border border-border bg-card p-5 mb-10">
            <p class="font-mono text-xs font-semibold uppercase tracking-widest text-muted-foreground mb-3">
              On this page
            </p>
            <ul class="flex flex-col">
              {toc.map((heading) => (
                <li>
                  <a href={`#${heading.slug}`} class="tap-link text-sm text-primary hover:underline">
                    {heading.text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}

        <div class="prose-content">
          <slot />
        </div>

        {faqs.length > 0 && (
          <div class="mt-16">
            <h2 class="font-display text-2xl font-semibold mb-2">Frequently Asked Questions</h2>
            <FAQAccordion faqs={faqs} />
          </div>
        )}

        {related.length > 0 && (
          <div class="mt-16 pt-10 border-t border-border">
            <p class="font-mono text-xs font-semibold uppercase tracking-widest text-muted-foreground mb-4">
              Related Guides
            </p>
            <div class="grid sm:grid-cols-2 gap-4">
              {related.map((r) => (
                <a href={`/guides/${r.id}`} class="card-hover flex flex-col gap-3 p-6 border border-border bg-card">
                  <span class="font-mono text-xs font-semibold tracking-widest uppercase text-primary">
                    {r.data.category}
                  </span>
                  <h3 class="font-display text-xl font-semibold leading-snug">{r.data.title}</h3>
                  <p class="text-sm text-muted-foreground leading-relaxed">{r.data.description}</p>
                  <span class="font-mono text-xs font-semibold text-primary mt-auto pt-1">Read the guide →</span>
                </a>
              ))}
            </div>
          </div>
        )}

        <div class="mt-16 border border-border bg-card p-8 md:p-10 text-center flex flex-col items-center gap-4">
          <h2 class="font-display text-2xl font-semibold">Want help implementing this?</h2>
          <p class="text-muted-foreground max-w-md">
            I take on a limited number of AI engineering engagements each quarter - RAG, agents, evals, or voice AI.
          </p>
          <a href="https://www.mtechzilla.com/contact" target="_blank" rel="noopener noreferrer" class="btn-primary">
            Talk to Me About AI →
          </a>
        </div>
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>
