---
import GithubIcon from "./icons/Github.astro";
import LinkedInIcon from "./icons/LinkedIn.astro";
import TwitterIcon from "./icons/Twitter.astro";
import InstagramIcon from "./icons/Instagram.astro";

const socialLinks = [
  { label: "LinkedIn", href: "https://www.linkedin.com/in/sharvinshah/", Icon: LinkedInIcon },
  { label: "GitHub", href: "https://github.com/Sharvin26", Icon: GithubIcon },
  { label: "Twitter / X", href: "https://x.com/sharvinshah26", Icon: TwitterIcon },
  { label: "Instagram", href: "https://www.instagram.com/thesharvinshah/", Icon: InstagramIcon },
];

const navColumn = [
  { label: "About", href: "#about" },
  { label: "Experience", href: "#experience" },
  { label: "Skills", href: "#skills" },
  { label: "Hobbies", href: "#hobbies" },
];

const mtechzillaColumn = [
  { label: "Our Work", href: "https://www.mtechzilla.com/our-work" },
  { label: "Services", href: "https://www.mtechzilla.com/services" },
  { label: "Blog", href: "https://www.mtechzilla.com/blog" },
  { label: "Contact", href: "https://www.mtechzilla.com/contact" },
];

const writingColumn = [
  { label: "freeCodeCamp", href: "https://www.freecodecamp.org/news/author/sharvin/" },
  { label: "MTechZilla Blog", href: "https://www.mtechzilla.com/blog" },
];
---

<footer style="background-color: var(--neutral-200)">
  <div class="border-t" style="border-color: var(--neutral-300)">
    <div class="max-w-[1200px] mx-auto px-6 py-14">
      <div class="grid md:grid-cols-[280px_1fr] gap-12 md:gap-20">
        <div class="flex flex-col gap-6">
          <div>
            <p class="text-base font-bold tracking-wide mb-3" style="color: var(--neutral-700)">
              Sharvin Shah
            </p>
            <p class="text-sm leading-relaxed" style="color: var(--neutral-500)">
              Founder &amp; CEO of MTechZilla. Building software for startups since 2021.
            </p>
          </div>
          <div class="flex flex-col gap-4">
            <div>
              <p class="text-xs font-semibold uppercase tracking-widest mb-1" style="color: var(--neutral-500)">
                Start a project
              </p>
              <a
                href="https://www.mtechzilla.com/contact"
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm font-medium underline underline-offset-4 transition-opacity hover:opacity-70"
                style="color: var(--primary-700)"
              >
                mtechzilla.com/contact
              </a>
            </div>
            <div>
              <p class="text-xs font-semibold uppercase tracking-widest mb-1" style="color: var(--neutral-500)">
                Read my writing
              </p>
              <a
                href="https://www.freecodecamp.org/news/author/sharvin/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm font-medium underline underline-offset-4 transition-opacity hover:opacity-70"
                style="color: var(--primary-700)"
              >
                freeCodeCamp
              </a>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 gap-8">
          <div>
            <p class="text-xs font-bold uppercase tracking-widest mb-4" style="color: var(--primary-700)">
              Navigation
            </p>
            <ul class="flex flex-col gap-2.5">
              {navColumn.map(({ label, href }) => (
                <li>
                  <a href={href} class="text-sm transition-colors hover:opacity-70" style="color: var(--neutral-600)">
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div>
            <p class="text-xs font-bold uppercase tracking-widest mb-4" style="color: var(--primary-700)">
              MTechZilla
            </p>
            <ul class="flex flex-col gap-2.5">
              {mtechzillaColumn.map(({ label, href }) => (
                <li>
                  <a
                    href={href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm transition-colors hover:opacity-70"
                    style="color: var(--neutral-600)"
                  >
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div>
            <p class="text-xs font-bold uppercase tracking-widest mb-4" style="color: var(--primary-700)">
              Writing
            </p>
            <ul class="flex flex-col gap-2.5">
              {writingColumn.map(({ label, href }) => (
                <li>
                  <a
                    href={href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm transition-colors hover:opacity-70"
                    style="color: var(--neutral-600)"
                  >
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="border-t" style="border-color: var(--neutral-300)">
    <div class="max-w-[1200px] mx-auto px-6 py-5 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs" style="color: var(--neutral-500)">
        © 2026, Sharvin Shah. All rights reserved.
      </p>

      <div class="flex items-center gap-2">
        {socialLinks.map(({ label, href, Icon }) => (
          <a href={href} target="_blank" rel="noopener noreferrer" aria-label={label} class="social-icon-btn">
            <Icon class="h-4 w-4" />
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
