---
interface Props {
  faqs: { question: string; answer: string }[];
}

const { faqs } = Astro.props;
---
{
  faqs.length > 0 && (
    <div class="flex flex-col">
      {faqs.map((faq) => (
        <details class="faq-item">
          <summary>{faq.question}</summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
  )
}
