---
interface Props {
  label: string;
  description: string;
  href?: string;
}

const { label, description, href } = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag href={href} class="expertise-row group">
  <span class="font-mono text-sm font-semibold uppercase tracking-wide text-foreground">
    {label}
  </span>
  <p class="text-sm text-muted-foreground leading-relaxed">{description}</p>
  {href && (
    <span class="font-mono text-xs font-semibold text-primary whitespace-nowrap">
      Read the guide →
    </span>
  )}
</Tag>
