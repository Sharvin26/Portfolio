---
interface Props {
  label: string;
  description: string;
  href?: string;
}

const { label, description, href } = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag
  href={href}
  class="card-hover flex flex-col gap-2 p-5 border border-border bg-card"
>
  <span class="font-mono text-xs font-semibold tracking-widest uppercase text-primary">
    {label}
  </span>
  <p class="text-sm leading-relaxed text-muted-foreground">{description}</p>
  {href && (
    <span class="font-mono text-xs font-semibold text-primary mt-1">
      Read the guide →
    </span>
  )}
</Tag>
