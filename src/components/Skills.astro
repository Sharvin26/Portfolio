---
// Ordered application layer -> infrastructure, so the panel reads as a stack.
const layers = [
  { label: "AI / LLM", items: ["OpenAI", "Anthropic", "LangChain", "LlamaIndex", "pgvector", "vLLM"], accent: true },
  { label: "Frontend", items: ["React", "Next.js", "TypeScript", "Tailwind CSS"] },
  { label: "Mobile", items: ["React Native", "Flutter"] },
  { label: "Backend", items: ["Node.js", "Express", "REST APIs", "Python"] },
  { label: "Data", items: ["PostgreSQL", "MongoDB", "Redis", "Supabase"] },
  { label: "Infra", items: ["AWS", "Docker", "Kubernetes", "Terraform"] },
];
---

<section id="stack" class="py-20 md:py-28 border-b border-border">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="animate-on-scroll grid lg:grid-cols-[1fr_minmax(0,620px)] gap-12 lg:gap-16 items-center">
      <div class="flex flex-col gap-6">
        <div class="flex items-center gap-5 -ml-1">
          <span class="index-numeral" aria-hidden="true">04</span>
          <div class="section-label">Stack</div>
        </div>
        <h2 class="font-display text-3xl md:text-[2.75rem] font-medium leading-[1.1]">
          The engineering <em class="text-primary italic">underneath.</em>
        </h2>
        <p class="text-base text-muted-foreground leading-relaxed max-w-[33rem]">
          An AI feature is only as good as the system it ships inside. The AI layer is where I
          spend my time now - the five below it are what make it survive contact with users.
        </p>
      </div>

      <div class="stack-panel">
        <div class="stack-axis" aria-hidden="true">
          <span>APP</span>
          <span class="stack-axis-line"></span>
          <span>INFRA</span>
        </div>

        <ul class="stack-layers">
          {layers.map((layer) => (
            <li class={`stack-layer${layer.accent ? " is-accent" : ""}`}>
              <span class="stack-layer-label">{layer.label}</span>
              <span class="stack-layer-items">
                {layer.items.map((item, i) => (
                  <>
                    {i > 0 && <span class="stack-sep" aria-hidden="true">·</span>}
                    <span>{item}</span>
                  </>
                ))}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
