---
import SkillCard from "./SkillCard.astro";

const skillCards = [
  {
    number: "01",
    title: "AI / LLM Infrastructure",
    skills: ["OpenAI", "Anthropic", "LangChain", "LlamaIndex", "pgvector", "vLLM"],
  },
  {
    number: "02",
    title: "Backend Development",
    skills: ["Node.js", "Express", "REST APIs", "Python"],
  },
  {
    number: "03",
    title: "Frontend Development",
    skills: ["React", "Next.js", "TypeScript", "Tailwind CSS"],
  },
  {
    number: "04",
    title: "Mobile Development",
    skills: ["React Native", "Flutter"],
  },
  {
    number: "05",
    title: "Databases",
    skills: ["PostgreSQL", "MongoDB", "MySQL", "Redis", "Supabase"],
  },
  {
    number: "06",
    title: "DevOps & Cloud",
    skills: ["AWS", "Docker", "Kubernetes", "CI/CD", "Terraform"],
  },
];
---

<section id="stack" class="py-16 md:py-20 border-b border-border">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="animate-on-scroll">
      <div class="section-label mb-6">Stack</div>
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10">
        <h2 class="font-display text-2xl md:text-3xl font-extrabold max-w-lg">The Engineering Underneath</h2>
        <p class="text-sm max-w-xs leading-relaxed text-muted-foreground">
          AI systems still need a real full-stack foundation. Here's what's under mine.
        </p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px border border-border" style="background-color: var(--border)">
        {skillCards.map((card) => (
          <SkillCard {...card} />
        ))}
      </div>
    </div>
  </div>
</section>
