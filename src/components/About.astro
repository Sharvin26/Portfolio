<section id="about" class="py-20 md:py-28 border-b border-border">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="animate-on-scroll">
      <div class="section-label mb-6">About Me</div>
      <div class="grid md:grid-cols-[1fr_1fr] gap-12 md:gap-20 items-start">
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold leading-tight">
          Software Engineer.<br />
          <span style="color: var(--primary-700)">Agency Founder.</span><br />
          Builder at heart.
