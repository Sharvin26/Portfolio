---
import ExperienceItem from "./ExperienceItem.astro";
---

<section id="experience" class="py-20 md:py-28 border-b border-border">
  <div class="max-w-[1200px] mx-auto px-6">
    <div class="animate-on-scroll">
      <div class="mb-14">
        <div class="flex flex-col gap-6">
          <div class="flex items-center gap-5 -ml-1">
            <span class="index-numeral" aria-hidden="true">04</span>
            <div class="section-label">Experience</div>
          </div>
          <h2 class="font-display text-3xl md:text-[2.75rem] font-medium leading-[1.1]">
            Where I've <em class="text-primary italic">built &amp; led.</em>
          </h2>
          <p class="text-base text-muted-foreground leading-relaxed max-w-[33rem]">
            Backend and IoT first, then my own company - and, running alongside both since 2020,
            writing about the work.
          </p>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-x-12 gap-y-10">
        <ExperienceItem
          title="CEO & Chief AI Officer"
          company="MTechZilla"
          period="Feb 2021 – Present"
          current
          description="I built MTechZilla to give startups real engineering support without the overhead of a large agency. Most of that work is now AI systems: RAG pipelines, agents, and the eval and guardrail infrastructure that makes them safe to ship."
        />
        <ExperienceItem
          title="Contributor"
          company="freeCodeCamp"
          period="May 2020 – Present"
          description="Practical guides on AI systems, SaaS architecture, and lessons from shipping real products. No toy examples."
        />
        <ExperienceItem
          title="Software Developer"
          company="KPlay Team"
          period="Jul 2020 – Jan 2021"
          description="Owned the backend REST APIs behind the platform's core features, working directly with the frontend team on contracts and performance."
        />
        <ExperienceItem
          title="Software Developer"
          company="Phynart"
          period="Oct 2018 – Mar 2020"
          description="Backend services and secure APIs for an IoT platform handling device data at scale, plus an over-the-air update system for shipping software to smart devices."
        />
      </div>
    </div>
  </div>
</section>
