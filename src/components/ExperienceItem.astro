---
interface Props {
  title: string;
  company: string;
  period: string;
  description: string;
  current?: boolean;
}

const { title, company, period, description, current } = Astro.props;
---

<div class="grid md:grid-cols-[180px_1fr] gap-4 md:gap-8 border-b border-border pb-10 mb-10 last:border-b-0 last:mb-0 last:pb-0">
  <div class="flex flex-col gap-1 pt-1">
    <span class="font-mono text-xs font-semibold tracking-widest uppercase text-muted-foreground">
      {period}
    </span>
    {current && (
      <span class="inline-flex items-center gap-1.5 text-xs font-semibold tracking-wide uppercase w-fit mt-1 px-2 py-0.5 bg-primary/15 text-primary">
        <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
        Current
      </span>
    )}
  </div>
  <div>
    <h3 class="text-xl md:text-2xl font-bold mb-0.5">{title}</h3>
    <p class="font-mono text-sm font-semibold tracking-widest uppercase mb-3 text-primary">
      {company}
    </p>
    <p class="text-base leading-relaxed font-normal text-muted-foreground">
      {description}
    </p>
  </div>
</div>
