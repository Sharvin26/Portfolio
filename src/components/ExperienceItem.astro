---
interface Props {
  title: string;
  company: string;
  period: string;
  description: string;
  current?: boolean;
}

const { title, company, period, description, current } = Astro.props;
---

<div class="relative pl-6 border-l border-border pb-1">
  <span class="experience-dot"></span>
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-2">
    <span class="font-mono text-xs font-semibold tracking-widest uppercase text-muted-foreground">
      {period}
    </span>
    {current && (
      <span class="inline-flex items-center gap-1.5 text-[0.6875rem] font-semibold tracking-wide uppercase px-2 py-0.5 bg-primary/15 text-primary">
        <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
        Current
      </span>
    )}
  </div>
  <h3 class="text-xl font-bold leading-tight mb-0.5">{title}</h3>
  <p class="font-mono text-sm font-semibold tracking-widest uppercase mb-3 text-primary">
    {company}
  </p>
  <p class="text-base leading-relaxed font-normal text-muted-foreground">
    {description}
  </p>
</div>
