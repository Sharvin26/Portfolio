---
const core = [
  { label: "Agents & Orchestration", note: "plan, call tools, act" },
  { label: "Retrieval & Knowledge", note: "ground it in your data" },
];
---

<figure class="schematic m-0">
  <div class="schematic-frame">
    <p class="schematic-label is-centered">Evaluation &amp; Safety</p>

    <div class="schematic-body">
      <div class="schematic-box" style="flex: 0 0 9.5rem">
        <span class="schematic-title">Voice</span>
        <span class="schematic-note">interface</span>
      </div>

      <span class="flow-arrow" aria-hidden="true"></span>

      <div class="schematic-stack">
        {core.map((item) => (
          <div class="schematic-box is-wide">
            <span class="schematic-title">{item.label}</span>
            <span class="schematic-note">{item.note}</span>
          </div>
        ))}
      </div>
    </div>

    <p class="schematic-label is-centered">Infra &amp; Performance</p>
  </div>
</figure>
