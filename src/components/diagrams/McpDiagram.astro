---
import Diagram from "../Diagram.astro";

const box = { fill: "oklch(0.205 0.007 62)", stroke: "oklch(0.37 0.009 66)" };
const text = "oklch(0.97 0.004 90)";
const muted = "oklch(0.56 0.01 70)";
const accent = "oklch(0.77 0.16 71)";

const SERVER_X = 360;
const SERVER_W = 250;
const BOX_H = 60;
const GAP = 20;

const servers = [
  { name: "MCP Server: Files", exposes: "resources" },
  { name: "MCP Server: DB", exposes: "tools" },
  { name: "MCP Server: Search", exposes: "prompts + tools" },
].map((server, i) => {
  const y = 20 + i * (BOX_H + GAP);
  return { ...server, y, centerY: y + BOX_H / 2 };
});

const hostCenterY = servers[1].centerY;
---
<Diagram minWidth={640} caption="One MCP client in the host app can talk to any number of independent MCP servers over a shared protocol.">
  <svg viewBox="0 0 640 260" role="img" aria-labelledby="mcp-diagram-title mcp-diagram-desc" class="w-full h-auto">
    <title id="mcp-diagram-title">Model Context Protocol architecture</title>
    <desc id="mcp-diagram-desc">
      A host application, such as an LLM chat client, embeds an MCP client. That client connects
      over the Model Context Protocol to multiple independent MCP servers, each exposing its own
      tools, resources, or prompts.
    </desc>
    <defs>
      <marker id="mcp-arrow" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
        <path d="M0,0 L8,4 L0,8 Z" fill={accent} />
      </marker>
    </defs>

    <rect x="30" y={hostCenterY - BOX_H / 2} width="210" height={BOX_H} fill={box.fill} stroke={box.stroke} stroke-width="1.5" />
    <text x="135" y={hostCenterY - 4} text-anchor="middle" font-size="13" font-family="monospace" fill={text}>Host App</text>
    <text x="135" y={hostCenterY + 14} text-anchor="middle" font-size="11" font-family="monospace" fill={muted}>(MCP Client)</text>

    {servers.map((server) => (
      <line
        x1="240"
        y1={hostCenterY}
        x2={SERVER_X - 10}
        y2={server.centerY}
        stroke={accent}
        stroke-width="2"
        marker-end="url(#mcp-arrow)"
      />
    ))}

    {servers.map((server) => (
      <>
        <rect x={SERVER_X} y={server.y} width={SERVER_W} height={BOX_H} fill={box.fill} stroke={box.stroke} stroke-width="1.5" />
        <text x={SERVER_X + SERVER_W / 2} y={server.centerY - 4} text-anchor="middle" font-size="13" font-family="monospace" fill={text}>
          {server.name}
        </text>
        <text x={SERVER_X + SERVER_W / 2} y={server.centerY + 14} text-anchor="middle" font-size="11" font-family="monospace" fill={muted}>
          {server.exposes}
        </text>
      </>
    ))}
  </svg>
</Diagram>
