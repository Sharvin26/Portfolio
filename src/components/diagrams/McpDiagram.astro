---
import Diagram from "../Diagram.astro";

const box = { fill: "oklch(0.205 0.007 62)", stroke: "oklch(0.37 0.009 66)" };
const text = "oklch(0.97 0.004 90)";
const muted = "oklch(0.56 0.01 70)";
const accent = "oklch(0.77 0.16 71)";
---

<Diagram caption="One MCP client in the host app can talk to any number of independent MCP servers over a shared protocol.">
  <svg viewBox="0 0 870 220" role="img" aria-labelledby="mcp-diagram-title mcp-diagram-desc" class="w-full h-auto">
    <title id="mcp-diagram-title">Model Context Protocol architecture</title>
    <desc id="mcp-diagram-desc">
      A host application, such as an LLM chat client, embeds an MCP client. That client connects
      over the Model Context Protocol to multiple independent MCP servers, each exposing its own
      tools, resources, or prompts.
    </desc>
    <defs>
      <marker id="mcp-arrow" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
        <path d="M0,0 L8,4 L0,8 Z" fill={accent} />
      </marker>
    </defs>

    <rect x="20" y="80" width="220" height="60" fill={box.fill} stroke={box.stroke} stroke-width="1.5" />
    <text x="130" y="106" text-anchor="middle" font-size="13" font-family="monospace" fill={text}>Host App</text>
    <text x="130" y="124" text-anchor="middle" font-size="11" font-family="monospace" fill={muted}>(MCP Client)</text>

    <line x1="240" y1="110" x2="330" y2="60" stroke={accent} stroke-width="2" marker-end="url(#mcp-arrow)" />
    <line x1="240" y1="110" x2="330" y2="110" stroke={accent} stroke-width="2" marker-end="url(#mcp-arrow)" />
    <line x1="240" y1="110" x2="330" y2="160" stroke={accent} stroke-width="2" marker-end="url(#mcp-arrow)" />

    <rect x="340" y="30" width="220" height="60" fill={box.fill} stroke={box.stroke} stroke-width="1.5" />
    <text x="450" y="56" text-anchor="middle" font-size="13" font-family="monospace" fill={text}>MCP Server: Files</text>
    <text x="450" y="74" text-anchor="middle" font-size="11" font-family="monospace" fill={muted}>resources</text>

    <rect x="340" y="80" width="220" height="60" fill={box.fill} stroke={box.stroke} stroke-width="1.5" />
    <text x="450" y="106" text-anchor="middle" font-size="13" font-family="monospace" fill={text}>MCP Server: DB</text>
    <text x="450" y="124" text-anchor="middle" font-size="11" font-family="monospace" fill={muted}>tools</text>

    <rect x="340" y="130" width="220" height="60" fill={box.fill} stroke={box.stroke} stroke-width="1.5" />
    <text x="450" y="156" text-anchor="middle" font-size="13" font-family="monospace" fill={text}>MCP Server: Search</text>
    <text x="450" y="174" text-anchor="middle" font-size="11" font-family="monospace" fill={muted}>prompts + tools</text>
  </svg>
</Diagram>
