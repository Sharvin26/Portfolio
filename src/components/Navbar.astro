---
const navLinks = [
  { label: "About", href: "/#about" },
  { label: "Expertise", href: "/#expertise" },
  { label: "Experience", href: "/#experience" },
  { label: "Guides", href: "/guides" },
];
---

<header class="nav-shell" data-navbar>
  <div class="nav-island" data-island>
    <div class="nav-island-inner">
      <a href="/" class="nav-wordmark" aria-label="Sharvin Shah — home">
        <span class="nav-glyph" aria-hidden="true">&#9656;</span>
        <span class="nav-wordmark-text">Sharvin Shah</span>
      </a>

      <nav class="nav-links" aria-label="Primary">
        {navLinks.map(({ label, href }) => (
          <a href={href} class="nav-link">
            {label}
          </a>
        ))}
      </nav>

      <div class="hidden md:flex shrink-0">
        <a href="https://www.mtechzilla.com/contact" target="_blank" rel="noopener noreferrer" class="nav-cta">
          Talk to Me About AI
          <span class="nav-cta-arrow" aria-hidden="true">&#8594;</span>
        </a>
      </div>

      <button
        class="hamburger-btn md:hidden flex flex-col items-center justify-center gap-[5px] min-w-[44px] min-h-[44px]"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="block h-px w-5 bg-foreground"></span>
        <span class="block h-px w-5 bg-foreground"></span>
        <span class="block h-px w-5 bg-foreground"></span>
      </button>
    </div>

    <div id="mobile-menu" class="nav-mobile-menu hidden" data-mobile-menu>
      {navLinks.map(({ label, href }) => (
        <a
          href={href}
          class="tap-link text-base font-medium text-muted-foreground hover:text-foreground transition-colors"
          data-mobile-link
        >
          {label}
        </a>
      ))}
      <a
        href="https://www.mtechzilla.com/contact"
        target="_blank"
        rel="noopener noreferrer"
        class="nav-cta self-start mt-2 mb-1"
        data-mobile-link
      >
        Talk to Me About AI
        <span class="nav-cta-arrow" aria-hidden="true">&#8594;</span>
      </a>
    </div>
  </div>
</header>

<script>
  const island = document.querySelector<HTMLElement>("[data-island]");
  const toggleBtn = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const mobileMenu = document.querySelector<HTMLElement>("[data-mobile-menu]");

  // Contract the island once the page has scrolled past the hero's top edge.
  // rAF-throttled so the scroll handler stays off the critical path.
  let ticking = false;
  const syncContracted = () => {
    island?.classList.toggle("is-contracted", window.scrollY > 24);
    ticking = false;
  };
  window.addEventListener(
    "scroll",
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(syncContracted);
    },
    { passive: true }
  );
  syncContracted();

  const isMenuOpen = () => mobileMenu?.classList.contains("is-open") === true;

  const closeMenu = ({ refocus = false } = {}) => {
    if (!isMenuOpen()) return;
    mobileMenu?.classList.add("hidden");
    mobileMenu?.classList.remove("is-open");
    toggleBtn?.classList.remove("is-open");
    toggleBtn?.setAttribute("aria-expanded", "false");
    if (refocus) toggleBtn?.focus();
  };

  toggleBtn?.addEventListener("click", () => {
    const isOpen = mobileMenu?.classList.toggle("hidden") === false;
    mobileMenu?.classList.toggle("is-open", isOpen);
    toggleBtn.classList.toggle("is-open", isOpen);
    toggleBtn.setAttribute("aria-expanded", String(isOpen));
    // Move focus into the menu so keyboard and VoiceOver users land there
    if (isOpen) mobileMenu?.querySelector<HTMLAnchorElement>("[data-mobile-link]")?.focus();
  });

  mobileMenu?.querySelectorAll("[data-mobile-link]").forEach((link) => {
    link.addEventListener("click", () => closeMenu());
  });

  // Escape dismisses and returns focus to the toggle
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMenu({ refocus: true });
  });

  // Tapping outside the island dismisses it
  document.addEventListener("click", (event) => {
    if (!isMenuOpen()) return;
    const target = event.target as Node;
    if (island?.contains(target)) return;
    closeMenu();
  });

  // Resizing up to the desktop breakpoint leaves no orphaned open menu
  window.matchMedia("(min-width: 768px)").addEventListener("change", (e) => {
    if (e.matches) closeMenu();
  });
</script>
