---
const stats = [
  { value: "10+", label: "Years Engineering" },
  { value: "40+", label: "Products Shipped" },
  { value: "2021", label: "Founded MTechZilla" },
  { value: "$10M+", label: "Client Revenue" },
];
---

<section class="ambient-glow border-b border-border flex flex-col" style="min-height: calc(100vh - 4rem); min-height: calc(100svh - 4rem)">
  <div class="flex-1 flex items-center justify-center">
    <div class="max-w-[820px] mx-auto px-6 w-full py-12 flex flex-col items-center text-center gap-6">
      <div class="section-label animate-hero-fade" style="animation-delay: 0.1s">
        <span class="inline-block w-1.5 h-1.5 rounded-full" style="background-color: var(--accent-500)"></span>
        CEO &amp; Chief AI Officer, MTechZilla
      </div>

      <h1
        class="font-display text-4xl sm:text-5xl lg:text-6xl font-medium leading-[1.05] tracking-tight animate-hero-fade"
        style="animation-delay: 0.2s"
      >
        I build AI systems that survive <em class="text-primary italic">production.</em>
      </h1>

      <p class="text-lg leading-relaxed max-w-lg text-muted-foreground animate-hero-fade" style="animation-delay: 0.35s">
        I'm Sharvin, CEO &amp; Chief AI Officer at <a href="https://www.mtechzilla.com/" target="_blank" rel="noopener noreferrer" class="font-semibold underline underline-offset-4 text-primary">MTechZilla</a> — I engineer RAG, agents, and voice AI for teams who need it to work, not just demo well.
      </p>

      <div class="flex flex-wrap justify-center gap-3 animate-hero-fade" style="animation-delay: 0.5s">
        <a href="https://www.mtechzilla.com/contact" target="_blank" rel="noopener noreferrer" class="btn-primary">
          Talk to Me About AI →
        </a>
        <a href="#expertise" class="btn-outline">
          See My Expertise
        </a>
      </div>
    </div>
  </div>

  <div class="animate-hero-fade" style="background-color: var(--neutral-800); animation-delay: 0.65s">
    <div class="max-w-[1240px] mx-auto px-6 py-6">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-0">
        {stats.map((stat) => (
          <div class="flex flex-col items-center text-center md:border-r border-border last:border-r-0">
            <span class="font-display text-3xl md:text-4xl font-medium leading-none text-primary">
              {stat.value}
            </span>
            <span class="font-mono text-xs font-semibold tracking-widest uppercase mt-2 text-muted-foreground">
              {stat.label}
            </span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
