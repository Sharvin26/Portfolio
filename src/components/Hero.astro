---
import { Image } from "astro:assets";
import sharvinPhoto from "../assets/sharvin.png";

const stats = [
  { value: "10+", label: "Years Experience" },
  { value: "30+", label: "Projects Shipped" },
  { value: "2021", label: "Founded MTechZilla" },
  { value: "$10M+", label: "Client Revenue" },
];
---

<section class="border-b border-border">
  <div class="max-w-[1200px] mx-auto px-6 w-full py-16 md:py-24">
    <div class="grid md:grid-cols-[1fr_300px] lg:grid-cols-[1fr_360px] gap-12 lg:gap-20 items-center">
      <div class="flex flex-col gap-7">
        <div class="section-label animate-hero-fade" style="animation-delay: 0.1s">
          Founder &amp; CEO, MTechZilla
        </div>

        <h1
          class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-[1.08] tracking-tight animate-hero-fade"
          style="animation-delay: 0.2s"
        >
          I turn product ideas<br />
          into
          <span style="color: var(--primary-700)">working software.</span>
        </h1>

        <p
          class="text-base leading-relaxed max-w-lg animate-hero-fade"
          style="color: var(--neutral-500); animation-delay: 0.35s"
        >
          I'm Sharvin — Founder &amp; CEO of
          <a
            href="https://www.mtechzilla.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold underline underline-offset-4"
            style="color: var(--primary-700)"
          >
            MTechZilla
          </a>
          . Over 10 years building full-stack web apps, mobile apps, and AI-powered
          tools — for startups and businesses that need real engineering, not just
          promises.
        </p>

        <div class="flex flex-wrap gap-3 animate-hero-fade" style="animation-delay: 0.5s">
          <a
            href="https://www.mtechzilla.com/contact"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary"
          >
            Work With Me →
          </a>
          <a
            href="https://www.mtechzilla.com/blog"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-outline"
          >
            Read My Blog
          </a>
        </div>
      </div>

      <div class="animate-hero-fade" style="animation-delay: 0.3s">
        <div
          class="relative w-full max-w-[260px] mx-auto md:max-w-none aspect-[3/4] overflow-hidden"
          style="border: 1.5px solid var(--border)"
        >
          <Image
            src={sharvinPhoto}
            alt="Sharvin Shah"
            widths={[260, 300, 360, 720]}
            sizes="(max-width: 768px) 260px, (max-width: 1024px) 300px, 360px"
            class="object-cover object-top w-full h-full"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </div>

  <div class="animate-hero-fade" style="background-color: var(--neutral-700); animation-delay: 0.65s">
    <div class="max-w-[1200px] mx-auto px-6 py-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-0">
        {stats.map((stat) => (
          <div
            class="flex flex-col items-center text-center md:border-r last:border-r-0"
            style="border-color: var(--dark-border)"
          >
            <span class="text-4xl md:text-5xl font-bold leading-none" style="color: var(--neutral-100)">
              {stat.value}
            </span>
            <span
              class="text-xs font-semibold tracking-widest uppercase mt-2"
              style="color: var(--neutral-400)"
            >
              {stat.label}
            </span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
