---
const layers = [
  { label: "Retrieval", note: "grounded in your data" },
  { label: "Agents", note: "tools, plans, retries" },
  { label: "Evals", note: "proof it still works" },
];
---

<figure class="schematic m-0">
  <p class="schematic-label">Users</p>
  <div class="schematic-tick" aria-hidden="true"></div>

  <div class="schematic-frame">
    <p class="schematic-label">Product</p>
    <div class="schematic-box">
      <p class="schematic-label">AI System</p>
      <ul class="schematic-rows">
        {layers.map((layer) => (
          <li>
            <span class="schematic-title">{layer.label}</span>
            <span class="schematic-note">{layer.note}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="schematic-tick" aria-hidden="true"></div>
  <p class="schematic-label">Your data</p>
</figure>
