---
interface Props {
  number: string;
  title: string;
  skills: string[];
}

const { number, title, skills } = Astro.props;
---

<div class="bg-card p-6 flex flex-col gap-4">
  <span class="font-mono text-xs font-bold tracking-widest text-muted-foreground">
    {number}
  </span>
  <h3 class="text-lg font-bold leading-tight">{title}</h3>
  <div class="flex flex-wrap gap-1.5">
    {skills.map((skill) => (
      <span class="text-xs font-medium px-2.5 py-1 bg-primary/15 text-primary">
        {skill}
      </span>
    ))}
  </div>
</div>
