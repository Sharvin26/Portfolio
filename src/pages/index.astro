---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Expertise from "../components/Expertise.astro";
import ResponsibleAI from "../components/ResponsibleAI.astro";
import Skills from "../components/Skills.astro";
import Footer from "../components/Footer.astro";
import JsonLd from "../components/schema/JsonLd.astro";
import { personSchema, organizationSchema } from "../lib/schema";

const siteDescription =
  "Sharvin Shah is CEO & Chief AI Officer at MTechZilla, building RAG pipelines, AI agents, and voice AI systems for teams who need production-grade AI engineering - not a demo.";

const keywords = [
  "Sharvin Shah",
  "MTechZilla",
  "AI engineer",
  "AI consulting",
  "RAG engineering",
  "AI agents",
  "LLM evaluation",
  "voice AI agents",
  "Model Context Protocol",
  "AI systems for startups",
];
---
<BaseLayout
  title="Sharvin Shah | CEO & Chief AI Officer, MTechZilla"
  description={siteDescription}
  keywords={keywords}
>
  <JsonLd data={[personSchema(), organizationSchema()]} />
  <div class="flex min-h-screen flex-col bg-background">
    <Navbar />
    <Hero />
    <main>
      <About />
      <Expertise />
      <ResponsibleAI />
      <Skills />
      <section class="ambient-glow py-24 md:py-32">
        <div class="max-w-300 mx-auto px-6 text-center flex flex-col items-center gap-6">
          <h2 class="font-display text-4xl md:text-6xl font-medium max-w-2xl leading-tight">
            Have an AI system that needs to <em class="text-primary italic">actually work</em>?
          </h2>
          <p class="text-base text-muted-foreground max-w-xl leading-relaxed">
            I take on a limited number of AI engineering engagements - RAG, agents,
            evals, or voice AI - each quarter. If you're evaluating whether your AI
            idea can survive production, let's talk.
          </p>
          <a href="https://www.mtechzilla.com/contact" target="_blank" rel="noopener noreferrer" class="btn-primary">
            Talk to Me About AI →
          </a>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>
