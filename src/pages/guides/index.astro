---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import JsonLd from "../../components/schema/JsonLd.astro";
import { breadcrumbSchema } from "../../lib/schema";

const guides = (await getCollection("guides")).sort(
  (a, b) => a.data.publishDate.getTime() - b.data.publishDate.getTime()
);

const description =
  "Practitioner guides on RAG, Model Context Protocol, LLM evaluation, AI agents, and voice AI agents - written from production experience, not theory.";
---

<BaseLayout
  title="AI Engineering Guides | Sharvin Shah"
  description={description}
  canonical="https://sharvinshah.com/guides"
>
  <JsonLd
    data={breadcrumbSchema([
      { name: "Home", url: "https://sharvinshah.com" },
      { name: "Guides", url: "https://sharvinshah.com/guides" },
    ])}
  />
  <div class="flex min-h-screen flex-col bg-background">
    <Navbar />
    <main class="py-16 md:py-24">
      <div class="max-w-[1200px] mx-auto px-6">
        <div class="section-label mb-6">Guides</div>
        <h1 class="font-display text-4xl md:text-5xl font-semibold max-w-2xl mb-4">
          AI Engineering Guides
        </h1>
        <p class="text-muted-foreground max-w-[33rem] mb-14 leading-relaxed">
          Long-form, practitioner-level guides on the AI/LLM engineering topics I work
          in daily - how they work, where they fail, and what production actually requires.
        </p>

        <div class="grid sm:grid-cols-2 gap-6">
          {guides.map((guide) => (
            <a href={`/guides/${guide.id}`} class="card-hover flex flex-col gap-3 p-6 border border-border bg-card">
              <span class="font-mono text-xs font-semibold tracking-widest uppercase text-primary">
                {guide.data.category}
              </span>
              <h2 class="font-display text-xl font-semibold leading-snug">{guide.data.title}</h2>
              <p class="text-sm text-muted-foreground leading-relaxed">{guide.data.description}</p>
              <span class="font-mono text-xs font-semibold text-primary mt-auto pt-1">Read the guide →</span>
            </a>
          ))}
        </div>
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>
