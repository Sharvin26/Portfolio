---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import JsonLd from "../../components/schema/JsonLd.astro";
import { breadcrumbSchema } from "../../lib/schema";

const guides = (await getCollection("guides")).sort(
  (a, b) => a.data.publishDate.getTime() - b.data.publishDate.getTime()
);

// Each card lists the guide's own H2s rather than a hand-maintained blurb, so
// the hub can never drift out of sync with what the guide actually covers.
const entries = await Promise.all(
  guides.map(async (guide) => {
    const { headings } = await render(guide);
    const words = guide.body?.split(/\s+/).length ?? 0;
    return {
      guide,
      sections: headings.filter((h) => h.depth === 2).map((h) => h.text),
      minutes: Math.max(1, Math.round(words / 220)),
      questions: guide.data.faqs.length,
    };
  })
);

const totalQuestions = entries.reduce((n, e) => n + e.questions, 0);

const description =
  "Practitioner guides to RAG, the Model Context Protocol, LLM evaluation, AI agents and voice AI agents - architecture, failure modes, cost and production tradeoffs, written from shipped systems rather than theory.";
---

<BaseLayout
  title="AI Engineering Guides | Sharvin Shah"
  description={description}
  canonical="https://sharvinshah.com/guides"
>
  <JsonLd
    data={breadcrumbSchema([
      { name: "Home", url: "https://sharvinshah.com" },
      { name: "Guides", url: "https://sharvinshah.com/guides" },
    ])}
  />
  <div class="flex min-h-screen flex-col bg-background">
    <Navbar />
    <main class="pt-32 pb-16 md:pt-36 md:pb-24">
      <div class="max-w-[1200px] mx-auto px-6">
        <div class="section-label mb-6">Guides</div>
        <h1 class="font-display text-4xl md:text-5xl font-semibold max-w-2xl mb-6">
          AI Engineering Guides
        </h1>
        <div class="max-w-[36rem] flex flex-col gap-4 mb-14">
          <p class="text-muted-foreground leading-relaxed">
            Five long-form guides on the AI engineering problems I work in daily: retrieval-augmented
            generation, the Model Context Protocol, LLM evaluation, AI agents, and voice AI agents.
            Each one covers the architecture, the failure modes I've actually hit in production, what
            it costs to run, and - the section most guides skip - when not to build the thing at all.
          </p>
          <p class="text-muted-foreground leading-relaxed">
            These are written from shipped client systems, not from a survey of other people's blog
            posts. Where I cite a number, it links to the primary source. Where I don't have data,
            I say so.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 gap-6">
          {entries.map(({ guide, sections, minutes, questions }) => (
            <a href={`/guides/${guide.id}`} class="card-hover flex flex-col gap-3 p-6 border border-border bg-card">
              <div class="flex items-baseline justify-between gap-3">
                <span class="font-mono text-xs font-semibold tracking-widest uppercase text-primary">
                  {guide.data.category}
                </span>
                <span class="font-mono text-[0.6875rem] tracking-wide text-muted-foreground shrink-0">
                  {minutes} min · {questions} questions
                </span>
              </div>
              <h2 class="font-display text-xl font-semibold leading-snug">{guide.data.title}</h2>
              <p class="text-sm text-muted-foreground leading-relaxed">{guide.data.description}</p>

              {sections.length > 0 && (
                <ul class="flex flex-wrap gap-x-2 gap-y-1.5 list-none p-0 m-0 mt-1">
                  {sections.slice(0, 5).map((section) => (
                    <li class="font-mono text-[0.6875rem] leading-tight text-muted-foreground border border-border px-2 py-1">
                      {section}
                    </li>
                  ))}
                </ul>
              )}

              <span class="font-mono text-xs font-semibold text-primary mt-auto pt-2">Read the guide →</span>
            </a>
          ))}
        </div>

        <div class="mt-16 pt-10 border-t border-border max-w-[36rem]">
          <h2 class="font-display text-2xl font-semibold mb-4">What these guides answer</h2>
          <p class="text-muted-foreground leading-relaxed mb-4">
            Across the five guides there are {totalQuestions} answered questions - the ones that
            actually come up on client calls rather than the ones that make for tidy headings:
          </p>
          <ul class="flex flex-col gap-2 text-muted-foreground leading-relaxed list-none p-0 m-0">
            <li>— Is RAG still relevant now that context windows hold a million tokens?</li>
            <li>— When is a workflow the right answer instead of an agent?</li>
            <li>— Is MCP the same thing as tool calling, and when is it overhead?</li>
            <li>— What's the difference between an eval and a benchmark?</li>
            <li>— What latency does a voice agent actually need to hit, and what does a call cost?</li>
          </ul>
        </div>
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>
